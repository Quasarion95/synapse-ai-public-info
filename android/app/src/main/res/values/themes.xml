<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Окно под приложением цвета бумаги веб-версии: при запуске и при
         повороте видно именно его, и белая вспышка на тёмной теме не мелькает. -->
    <style name="Theme.Synapse" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#F5F1E8</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
