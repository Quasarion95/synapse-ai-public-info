<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Сеть нужна ассистенту и оплате. Планирование работает и без неё:
         записи лежат на устройстве, файлы приложения — внутри apk. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Микрофон нужен только голосовым командам ассистента и спрашивается в
         момент нажатия, а не на запуске. Приложение остаётся полностью
         работоспособным при отказе. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Короткий отклик, когда карточка поднялась на перетаскивание. Без
         этого разрешения navigator.vibrate в WebView молча ничего не делает,
         и жест кажется несработавшим: карточка уже взята, а рука об этом не
         знает. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Напоминания о задачах, целях и брифинге. С Android 13 разрешение
         спрашивается в момент, когда приложение впервые реально ставит
         напоминание (пересобратьНапоминания в app.js), а не по тумблеру:
         напоминания включены по умолчанию, тумблер никто не трогает, и запрос
         иначе не срабатывал бы вовсе. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Счётчик-бейдж на иконке (Samsung One UI). Без него система пишет
         SecurityException при попытке обновить число на значке приложения —
         само уведомление показывается, а цифра на иконке нет. -->
    <uses-permission android:name="com.sec.android.provider.badge.permission.READ" />
    <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE" />

    <!-- Будильник переживает засыпание системы: напоминание в 9 утра бесполезно,
         если придёт, когда телефон проснётся сам. Точное время не просим — для
         напоминания хватает окна в четверть часа, а разрешение на точные
         будильники магазины смотрят придирчиво. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- MyTracker по умолчанию просит рекламный идентификатор телефона. Нам он
         не нужен: рекламу в приложении мы не показываем, а для статистики
         хватает обезличенного счётчика установок. Убираем. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- И покупки через Google Play: в приложении их нет, подписка — на сайте. -->
    <uses-permission android:name="com.android.vending.BILLING" tools:node="remove" />

    <!-- Без этого система не покажет нам установленный распознаватель речи, и
         isRecognitionAvailable вернёт false на ровном месте. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>

        <!-- И браузер тоже надо объявить, иначе его для нас не существует.

             С Android 11 приложение видит чужие только через этот список.
             targetSdk у нас 34, браузер объявлен не был — и startActivity на
             https-ссылку падал с ActivityNotFoundException. Ловилось оно
             молча, поэтому «Оформить подписку» просто ничего не делала: ни
             перехода, ни ошибки. Ровно та поломка, о которой сказал
             пользователь. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".SynapseApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.Synapse">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ссылка активации подписки.

                 Страница оплаты на сайте открывает synapse://activate?code=…
                 На айфоне это ловит приложение и включает Pro само; андроид до
                 сих пор такую ссылку не понимал, и человек переписывал
                 двенадцать знаков из браузера в приложение руками. На этом
                 переносе покупатели и теряются. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="synapse" android:host="activate" />
            </intent-filter>
        </activity>
    
        <!-- Показывает напоминание, когда приложение закрыто. exported=false:
             будить его вправе только наш будильник, снаружи звать незачем. -->
        <receiver
            android:name=".ПоказатьНапоминание"
            android:exported="false" />

        <!-- Ставит напоминания заново после перезагрузки: система забывает все
             будильники при выключении. Разрешение RECEIVE_BOOT_COMPLETED выше
             было объявлено с самого начала, а приёмника не было — и после
             перезагрузки не приходило ничего, пока не откроешь приложение.
             exported=true обязателен: иначе системная рассылка сюда не дойдёт;
             чужие вызовы отсекает проверка действия внутри. -->
        <receiver
            android:name=".ПослеЗагрузки"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
